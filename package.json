{
  "name": "githeaven",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test": "vitest run",
    "demo": "node scripts/create-demo.mjs",
    "stress": "node scripts/create-stress-demo.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm test && pnpm build && cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "oxlint --deny-warnings src scripts vite.config.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@pierre/diffs": "1.4.0",
    "@pierre/trees": "1.0.0-beta.6",
    "@tanstack/react-virtual": "^3.13.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.3.4"
}
